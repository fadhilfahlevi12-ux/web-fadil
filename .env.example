# ===== Supabase (PostgreSQL) =====
# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Gunakan string "Session pooler" / "Transaction pooler" (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# ===== NextAuth (Auth.js) =====
# Generate dengan: npx auth secret (atau openssl rand -base64 32)
AUTH_SECRET=""

# ===== Supabase Storage (opsional — untuk upload berkas arsip & PDF surat) =====
# Kosongkan bila belum dipakai: modul arsip tetap bisa menyimpan dokumen via URL,
# dan PDF surat dibuat saat diminta lewat /api/surat/[id]/pdf.
# SUPABASE_URL: Project Settings -> API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role (RAHASIA, server-side saja)
# SUPABASE_STORAGE_BUCKET: nama bucket (default "arsip-prodi"), buat bucket + policy di Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="arsip-prodi"

# ===== URL aplikasi (opsional) =====
# Basis URL absolut yang dicetak pada QR Code PDF surat -> {APP_URL}/validasi/{qrToken}.
# Kosongkan saat pengembangan: sistem memakai host permintaan (mis. http://localhost:3000).
# Isi saat produksi (mis. https://simap-ti.umpar.ac.id) agar QR hasil unggahan
# ke Supabase Storage tetap mengarah ke domain yang benar.
APP_URL=""
